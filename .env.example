# ==============================================================================
# CHARUSAT SMART ATTENDANCE & ANALYTICS — ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file defines all environment variables required by the API server,
# database connectors, security engines, and frontend application.
# Copy this file to `.env` in local development or set these variables
# directly in your production hosting platform (e.g., Docker, ECS, Kubernetes,
# Render, Railway, AWS App Runner).
#
# DO NOT COMMIT REAL PRODUCTION SECRETS OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Purpose: Connection string for PostgreSQL database instance.
# Example format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# Required in Development: YES
# Required in Production: YES
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/charusat_attendance?sslmode=disable

# ------------------------------------------------------------------------------
# 2. SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Purpose: Defines Node.js runtime environment mode ('development', 'production', or 'test').
# Example format: development | production | test
# Required in Development: NO (defaults to 'development')
# Required in Production: YES (must be 'production')
NODE_ENV=development

# Purpose: TCP network port on which the Express API server listens.
# Example format: 5000 (integer)
# Required in Development: NO (defaults to 5000)
# Required in Production: NO (defaults to 5000 or platform $PORT)
PORT=5000

# Purpose: Logging verbosity level for Pino structured JSON logger.
# Example format: fatal | error | warn | info | debug | trace
# Required in Development: NO (defaults to 'info')
# Required in Production: NO (defaults to 'info')
LOG_LEVEL=info

# Purpose: Whitelist of allowed Cross-Origin Resource Sharing (CORS) origins.
# In production, set to your exact HTTPS frontend domain. Multiple domains comma-separated.
# Example format: https://attendance.charusat.ac.in,https://app.charusat.ac.in
# Required in Development: NO (defaults to reflection/allow all)
# Required in Production: YES
CORS_ORIGIN=https://attendance.charusat.ac.in

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION SECURITY
# ------------------------------------------------------------------------------
# Purpose: Cryptographic symmetric key used for HMAC-SHA256 signing and verification
# of authentication JWT tokens. Must be a high-entropy string (min 32 bytes).
# Example format: 64-character hex or base64 string
# Required in Development: NO (falls back to dev key with warning)
# Required in Production: YES (server will refuse to boot without secure key)
JWT_SECRET=replace-with-a-random-64-character-hex-string-for-production-use

# Purpose: JWT token expiration period. Supported units: s, m, h, d.
# Example format: 24h, 12h, 7d
# Required in Development: NO (defaults to '24h')
# Required in Production: NO (defaults to '24h')
TOKEN_EXPIRY=24h

# Purpose: Bcrypt salt rounds used for password hashing on user registration & passwords.
# Higher is more secure but slower on CPU.
# Example format: 12 (integer between 10 and 14)
# Required in Development: NO (defaults to 12)
# Required in Production: NO (defaults to 12)
BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# 4. ANTI-PROXY QR CODE ENGINE
# ------------------------------------------------------------------------------
# Purpose: Cryptographic secret key used to compute HMAC-SHA256 signatures for
# dynamic 15-second rotating classroom QR challenge tokens. Prevents token forgery
# and replay attacks across lecture halls.
# Example format: 64-character hex string
# Required in Development: NO (falls back to dev key with warning)
# Required in Production: YES (server will refuse to boot without secure key)
QR_HMAC_SECRET=replace-with-a-unique-64-character-hex-secret-for-qr-hmac

# ------------------------------------------------------------------------------
# 5. WEBAUTHN / FIDO2 HARDWARE PASSKEY CONFIGURATION
# ------------------------------------------------------------------------------
# Purpose: Human-readable name of the Relying Party shown on student biometric prompts.
# Example format: "Charotar University of Science and Technology"
# Required in Development: NO (defaults to 'CHARUSAT Smart Attendance')
# Required in Production: NO (defaults to 'CHARUSAT Smart Attendance')
WEBAUTHN_RP_NAME=CHARUSAT Smart Attendance

# Purpose: Relying Party identifier (domain/hostname). Must match the effective
# domain of the frontend web application where students register and verify passkeys.
# In local dev: "localhost". In production: your registered domain (e.g. "charusat.ac.in").
# Note: FIDO2 specifications forbid protocol/port in RP_ID.
# Example format: localhost (dev) | attendance.charusat.ac.in (prod)
# Required in Development: NO (defaults to 'localhost')
# Required in Production: YES (hardware passkeys fail if RP_ID mismatches origin)
WEBAUTHN_RP_ID=localhost

# Purpose: Fully-qualified HTTPS origin of the frontend web application.
# Includes protocol, domain, and optional port. The browser WebAuthn API compares
# this against the incoming clientDataJSON.
# Example format: http://localhost:5173 (dev) | https://attendance.charusat.ac.in (prod)
# Required in Development: NO (defaults to 'http://localhost:5173')
# Required in Production: YES
WEBAUTHN_ORIGIN=http://localhost:5173

# Purpose: Timeout in milliseconds for active WebAuthn registration/authentication challenges.
# Example format: 120000 (integer, default 2 minutes)
# Required in Development: NO (defaults to 120000)
# Required in Production: NO (defaults to 120000)
WEBAUTHN_CHALLENGE_TIMEOUT_MS=120000

# ------------------------------------------------------------------------------
# 6. INITIAL SEED & DEMO PROVISIONING
# ------------------------------------------------------------------------------
# Purpose: Controls whether the database is seeded with initial academic cohorts,
# subjects, and demo users on server startup if the users table is empty.
# Set to 'false' in production if managing data exclusively through migrations/admin tools.
# Example format: true | false
# Required in Development: NO (defaults to 'true')
# Required in Production: NO (defaults to 'true')
AUTO_SEED=true

# Purpose: Initial default password assigned to seeded demo accounts (Admin, Faculty, Student).
# Example format: complex-random-seed-password
# Required in Development: NO (defaults to 'charusat123')
# Required in Production: YES (if AUTO_SEED=true, use a strong password)
DEFAULT_SEED_PASSWORD=charusat123

# ------------------------------------------------------------------------------
# 7. FRONTEND VITE CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
# Purpose: Backend API server target URL for the Vite development reverse proxy (/api).
# Example format: http://localhost:5000 | http://127.0.0.1:5000
# Required in Development: NO (defaults to 'http://localhost:5000')
# Required in Production: NO (frontend communicates with same origin or ingress)
API_URL=http://localhost:5000

# Purpose: Base URL path for deploying frontend under a sub-path if needed.
# Example format: / | /attendance/
# Required in Development: NO (defaults to '/')
# Required in Production: NO (defaults to '/')
BASE_PATH=/
